
<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Important Message</title>
  <style>
    body {
      background: #111;
      color: white;
      font-family: Arial;
      text-align: center;
      padding: 40px 15px;
    }
    button {
      padding: 16px 30px;
      border: 0;
      border-radius: 12px;
      font-size: 18px;
      cursor: pointer;
    }
    video {
      width: 100%;
      max-width: 500px;
      margin-top: 25px;
    }
  </style>
</head>
<body>
  <h1>🎁 You have a message!</h1>
  <p>Something important is waiting for you.</p>

  <button id="play">OPEN MESSAGE</button>

  <p id="status">Preparing video...</p>

  <video id="video" controls playsinline></video>

  <script>
    const video = document.getElementById("video");
    const button = document.getElementById("play");
    const status = document.getElementById("status");

    async function prepare() {
      try {
        const response = await fetch("rickroll.mp4");
        if (!response.ok) throw new Error("Video unavailable");

        const blob = await response.blob();
        video.src = URL.createObjectURL(blob);
        status.textContent = "Ready!";
        button.disabled = false;
      } catch (error) {
        status.textContent = "Please connect to the internet first.";
      }
    }

    button.disabled = true;

    button.addEventListener("click", async () => {
      await video.play();
    });

    if ("serviceWorker" in navigator) {
      navigator.serviceWorker.register("sw.js");
    }

    prepare();
  </script>
</body>
</html>
